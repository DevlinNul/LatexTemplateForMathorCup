% 学术规范起见，不要生造参考文献，也不建议直接正文出无引用然后用 \nocite{*} 即便评委可能根本开不出来（x)
% 被使用的参考文献字段就是示例里提供的字段

% 书籍
@book{book01,
  author    = {张三 and 李四},
  title     = {算法导论},
  location  = {北京},
  publisher = {清华大学出版社},
  year      = {2022}
}

% 期刊
@article{paper01,
  author  = {李四},
  title   = {深度学习新进展},
  journal = {计算机学报},
  volume  = {12},
  number  = {3},
  pages   = {45-56},
  year    = {2023}
}

% 网络资源
@online{web01,
  author  = {王五},
  title   = {LaTeX 调教指南略略略},
  url     = {https://www.latex-project.org},
  urldate = {2024-04-08}
}

% AI工具 (使用我们自定义的 @AI)
% 把 AI 列进参考文献也是神人在里面
@ai{deepseek,
  title     = {DeepSeek},
  version   = {DeepSeek-V3},
  publisher = {深度求索（DeepSeek）},
  urldate   = {2035-10-01}
}
% urldate 注意严格 YYYY-MM-DD 格式，不足的部分补零